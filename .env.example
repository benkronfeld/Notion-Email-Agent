# Notion Deadline Reminder Agent — environment template
#
# Copy to `.env` and fill in the blank values. NEVER commit `.env` or any real secret.
# On Railway, set these as platform environment variables instead of a file.
#
# Values shown are the spec defaults (project_spec final.md §2.2 and §1.2).
# Blank = you must supply it.

# ─────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────

# PostgreSQL 16 connection string (Railway provides this for the managed DB).
DATABASE_URL=

# Owner / recipient settings
TIMEZONE=America/New_York
DEFAULT_DUE_TIME=23:59
REMINDER_RECIPIENT=bek229@lehigh.edu

# Comma-separated. Only replies from these addresses are processed (FR-11).
ALLOWED_REPLY_SENDERS=bek229@lehigh.edu

# Ops API. Everything except /healthz requires `Authorization: Bearer <token>`.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# ─────────────────────────────────────────────────────────────
# Notion
# ─────────────────────────────────────────────────────────────

# Internal integration token (secret_...), shared with BOTH databases and the Course database.
NOTION_TOKEN=
NOTION_VERSION=2025-09-03

# The ID of each database ITSELF — not the wrapper page it may live inside
# (e.g. not the "Assignments & Readings" page). The data_source_id is resolved
# from these at startup (§2.3.2.A).
NOTION_DB_ASSIGNMENTS_READINGS=
NOTION_DB_EXAMS_PROJECTS=

# Property names. `TITLE` may be left blank — the title property is discovered by
# its Notion type and needs no config. All others default to the names below.
NOTION_PROP_TITLE=
NOTION_PROP_COURSE=Course
NOTION_PROP_TYPE=Type
NOTION_PROP_DUE=Due Date
NOTION_PROP_STATUS=Status
NOTION_PROP_DONE=Done

# Status option name that means "complete". `is_complete` = Done checked OR Status == this.
NOTION_STATUS_COMPLETED=Completed

# Whether each database has the `Done` checkbox. When true, the app writes Status and
# Done together in one PATCH (mirroring Notion's "Mark as done" button). When false,
# only Status is written. Confirmed true for both on 2026-09-28.
NOTION_ASSIGNMENTS_READINGS_HAS_DONE=true
NOTION_EXAMS_PROJECTS_HAS_DONE=true

# Sync cadence
NOTION_SYNC_INTERVAL_MIN=60
NOTION_COURSE_CACHE_TTL_HOURS=24
NOTION_FULL_RECONCILE_CRON=04:00

# ─────────────────────────────────────────────────────────────
# Gmail API  (dedicated sender account; recipient is REMINDER_RECIPIENT above)
# ─────────────────────────────────────────────────────────────

GMAIL_SENDER_ADDRESS=

# OAuth client for the dedicated account. Scopes: gmail.send + gmail.readonly.
# Obtain GMAIL_REFRESH_TOKEN once, locally:
#   python -m app.cli gmail-auth
# Keep the OAuth consent screen set to "In production" — refresh tokens issued to
# apps in "Testing" status expire after ~7 days and reminders would silently stop.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

GMAIL_POLL_INTERVAL_SEC=90
MAX_OUTBOUND_EMAILS_PER_HOUR=20

# ─────────────────────────────────────────────────────────────
# DeepSeek  (the only LLM use: reply text -> structured intent)
# ─────────────────────────────────────────────────────────────

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ─────────────────────────────────────────────────────────────
# Scheduling & safety limits
# ─────────────────────────────────────────────────────────────

REMINDER_SCHEDULER_INTERVAL_SEC=300
MAX_CLARIFICATION_ROUNDS=3
MAX_DATE_SHIFT_DAYS=60
ALERT_COOLDOWN_HOURS=6
